{{!
    @template mod_fraction/calculator

    Example context (json):
    {
        *Example context (json):*
    }
}}
<div id="{{rootid}}" class="fraction-calculator" data-region="fraction-calculator">
    <main class="fraction-workspace">
        <header class="fraction-workspace-header">
            <div>
                <h2 data-active-title>{{add}}</h2>
                <p>{{calculateautomatically}}</p>
            </div>
            <nav class="fraction-mode-tabs" aria-label="{{selectoperation}}">
                <button type="button" class="fraction-mode-button is-active" data-mode="add" aria-pressed="true">{{add}}</button>
                <button type="button" class="fraction-mode-button" data-mode="subtract" aria-pressed="false">{{subtract}}</button>
                <button type="button" class="fraction-mode-button" data-mode="multiply" aria-pressed="false">{{multiply}}</button>
                <button type="button" class="fraction-mode-button" data-mode="divide" aria-pressed="false">{{divide}}</button>
                <button type="button" class="fraction-mode-button" data-mode="compare" aria-pressed="false">{{compare}}</button>
                <button type="button" class="fraction-mode-button" data-mode="simplify" aria-pressed="false">{{simplify}}</button>
                <button type="button" class="fraction-mode-button" data-mode="convert" aria-pressed="false">{{convert}}</button>
            </nav>
        </header>
        <div class="fraction-tool-content">

    <div class="fraction-section" data-tool="simplify" hidden>
        <h3>{{simplify}}</h3>
        <div class="fraction-input-row">
            <label class="fraction-field">
                <span>{{numerator}}</span>
                <input class="form-control" type="number" step="1" value="18" data-field="simplify-numerator">
            </label>
            <span class="fraction-slash" aria-hidden="true">/</span>
            <label class="fraction-field">
                <span>{{denominator}}</span>
                <input class="form-control" type="number" step="1" value="24" data-field="simplify-denominator">
            </label>
        </div>

        <div class="fraction-visuals">
            <h4>{{visualrepresentation}}</h4>
            <div class="fraction-visual-grid fraction-visual-grid-single">
                <div class="fraction-visual-card"><div data-bar="a"></div></div>
            </div>
        </div>
        <div class="fraction-result" data-result="simplify" aria-live="polite"></div>

        <div class="fraction-visual-outcome">
            <h4>{{visualresult}}</h4>
            <div data-bar="result"></div>
        </div>
    </div>

    <div class="fraction-section" data-tool="compare" hidden>
        <h3>{{compare}}</h3>
        <div class="fraction-pair-grid">
            <fieldset class="fraction-card">
                <legend>{{fractiona}}</legend>
                <div class="fraction-stacked-input">
                    <input class="form-control" type="number" step="1" value="3" data-field="compare-a-numerator" aria-label="{{fractiona}} - {{numerator}}">
                    <span></span>
                    <input class="form-control" type="number" step="1" value="4" data-field="compare-a-denominator" aria-label="{{fractiona}} - {{denominator}}">
                </div>
            </fieldset>
            <div class="fraction-operator" data-region="compare-symbol">?</div>
            <fieldset class="fraction-card">
                <legend>{{fractionb}}</legend>
                <div class="fraction-stacked-input">
                    <input class="form-control" type="number" step="1" value="5" data-field="compare-b-numerator" aria-label="{{fractionb}} - {{numerator}}">
                    <span></span>
                    <input class="form-control" type="number" step="1" value="8" data-field="compare-b-denominator" aria-label="{{fractionb}} - {{denominator}}">
                </div>
            </fieldset>
        </div>

        <div class="fraction-visuals">
            <h4>{{visualrepresentation}}</h4>
            <div class="fraction-visual-grid">
                <div class="fraction-visual-card">
                    <span class="fraction-visual-caption">{{fractiona}}</span>
                    <div data-bar="a"></div>
                </div>
                <div class="fraction-visual-card">
                    <span class="fraction-visual-caption">{{fractionb}}</span>
                    <div data-bar="b"></div>
                </div>
            </div>
        </div>
        <div class="fraction-result" data-result="compare" aria-live="polite"></div>
    </div>

    <div class="fraction-section" data-tool="addsubtract">
        <h3>{{addsubtract}}</h3>
        <div class="fraction-operation-tabs" role="group" aria-label="{{addsubtract}}">
            <button type="button" class="btn btn-secondary active" data-operation="add">{{add}}</button>
            <button type="button" class="btn btn-secondary" data-operation="subtract">{{subtract}}</button>
        </div>
        <div class="fraction-pair-grid fraction-pair-grid-operation">
            <div class="fraction-stacked-input">
                <input class="form-control" type="number" step="1" value="3" data-field="addsub-a-numerator" aria-label="{{fractiona}} - {{numerator}}">
                <span></span>
                <input class="form-control" type="number" step="1" value="4" data-field="addsub-a-denominator" aria-label="{{fractiona}} - {{denominator}}">
            </div>
            <div class="fraction-operator" data-region="addsub-symbol">+</div>
            <div class="fraction-stacked-input">
                <input class="form-control" type="number" step="1" value="2" data-field="addsub-b-numerator" aria-label="{{fractionb}} - {{numerator}}">
                <span></span>
                <input class="form-control" type="number" step="1" value="3" data-field="addsub-b-denominator" aria-label="{{fractionb}} - {{denominator}}">
            </div>
        </div>

        <div class="fraction-visuals">
            <h4>{{visualrepresentation}}</h4>
            <div class="fraction-visual-grid">
                <div class="fraction-visual-card">
                    <span class="fraction-visual-caption">{{fractiona}}</span>
                    <div data-bar="a"></div>
                </div>
                <div class="fraction-visual-card">
                    <span class="fraction-visual-caption">{{fractionb}}</span>
                    <div data-bar="b"></div>
                </div>
            </div>
        </div>
        <div class="fraction-result" data-result="addsubtract" aria-live="polite"></div>

        <div class="fraction-visual-outcome">
            <h4>{{visualresult}}</h4>
            <div data-bar="result"></div>
        </div>
    </div>

    <div class="fraction-section" data-tool="multiplydivide" hidden>
        <h3>{{multiplydivide}}</h3>
        <div class="fraction-operation-tabs" role="group" aria-label="{{multiplydivide}}">
            <button type="button" class="btn btn-secondary active" data-operation="multiply">{{multiply}}</button>
            <button type="button" class="btn btn-secondary" data-operation="divide">{{divide}}</button>
        </div>
        <div class="fraction-pair-grid fraction-pair-grid-operation">
            <div class="fraction-stacked-input">
                <input class="form-control" type="number" step="1" value="2" data-field="muldiv-a-numerator" aria-label="{{fractiona}} - {{numerator}}">
                <span></span>
                <input class="form-control" type="number" step="1" value="5" data-field="muldiv-a-denominator" aria-label="{{fractiona}} - {{denominator}}">
            </div>
            <div class="fraction-operator" data-region="muldiv-symbol">×</div>
            <div class="fraction-stacked-input">
                <input class="form-control" type="number" step="1" value="3" data-field="muldiv-b-numerator" aria-label="{{fractionb}} - {{numerator}}">
                <span></span>
                <input class="form-control" type="number" step="1" value="7" data-field="muldiv-b-denominator" aria-label="{{fractionb}} - {{denominator}}">
            </div>
        </div>

        <div class="fraction-visuals">
            <h4>{{visualrepresentation}}</h4>
            <div class="fraction-visual-grid">
                <div class="fraction-visual-card">
                    <span class="fraction-visual-caption">{{fractiona}}</span>
                    <div data-bar="a"></div>
                </div>
                <div class="fraction-visual-card">
                    <span class="fraction-visual-caption">{{fractionb}}</span>
                    <div data-bar="b"></div>
                </div>
            </div>
        </div>
        <div class="fraction-result" data-result="multiplydivide" aria-live="polite"></div>

        <div class="fraction-visual-outcome">
            <h4>{{visualresult}}</h4>
            <div data-bar="result"></div>
        </div>
    </div>

    <div class="fraction-section" data-tool="convert" hidden>
        <h3>{{convert}}</h3>
        <div class="fraction-convert-grid">
            <div class="fraction-card">
                <h4>{{fractiontodecimal}}</h4>
                <div class="fraction-stacked-input fraction-stacked-input-small">
                    <input class="form-control" type="number" step="1" value="3" data-field="convert-fraction-numerator" aria-label="{{numerator}}">
                    <span></span>
                    <input class="form-control" type="number" step="1" value="8" data-field="convert-fraction-denominator" aria-label="{{denominator}}">
                </div>
                <div class="fraction-result" data-result="fractiontodecimal" aria-live="polite"></div>
            </div>
            <div class="fraction-card">
                <h4>{{decimaltofraction}}</h4>
                <label class="fraction-field fraction-decimal-field">
                    <span>{{decimal}}</span>
                    <input class="form-control" type="text" inputmode="decimal" value="0,375" data-field="convert-decimal">
                </label>
                <div class="fraction-result" data-result="decimaltofraction" aria-live="polite"></div>
            </div>
        </div>
    </div>
        </div>
    </main>
</div>
